              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "   const testCase = pm.iterationData.get(\"case\") || \"single run\";\r\n   const expected = pm.iterationData.get(\"expected_status\") || 400;\r\n\r\n   pm.test(`[${testCase}] status is ${expected}`, function () {\r\n       pm.expect(pm.response.code).to.eql(expected);\r\n   });\r\n\r\n   pm.test(`[${testCase}] error message mentions password rules`, function () {\r\n       const body = pm.response.json();\r\n       pm.expect(body.message).to.include(\"Password\");\r\n   });"
                ]
              }
            }
          ],
