            "exec": [
              "pm.test(\"Status code is 201\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\npm.test(\"Response has userID\", function () {\r\n    const response = pm.response.json();\r\n    pm.expect(response).to.have.property(\"userID\");\r\n    pm.expect(response.userID).to.be.a(\"string\");\r\n});\r\n\r\npm.test(\"Username matches request\", function () {\r\n    pm.expect(pm.response.json().username).to.eql(pm.environment.get(\"user name\"));\r\n});\r\n\r\nif (pm.response.code === 201) {\r\n    pm.environment.set(\"userID\", pm.response.json().userID);\r\n}"
