          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Book exists in user's collection\", function () {\r\n    const response = pm.response.json();\r\n    const expectedIsbn = pm.environment.get(\"isbn\");\r\n    const found = response.books.some(book => book.isbn === expectedIsbn);\r\n    pm.expect(found).to.be.true;\r\n});"
            ]
          }
        }
