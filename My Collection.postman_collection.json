    {
      "name": "POST - Add Book to Collection",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\npm.test(\"Book added with correct ISBN\", function () {\r\n    const response = pm.response.json();\r\n    const expectedIsbn = pm.environment.get(\"isbn\");\r\n    pm.expect(response.books).to.be.an(\"array\");\r\n    pm.expect(response.books[0].isbn).to.eql(expectedIsbn);\r\n});\r\n\r\npm.test(\"Authorization header was required\", function () {\r\n    pm.expect(pm.request.headers.has(\"Authorization\")).to.be.true;\r\n});"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              ""
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"userId\": \"{{userID}}\",\r\n  \"collectionOfIsbns\": [\r\n    { \"isbn\": \"{{isbn}}\" }\r\n  ]\r\n}",
