      "name": "GET All Books",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Response has books array\", function () {\r\n    const response = pm.response.json();\r\n    pm.expect(response).to.have.property(\"books\");\r\n    pm.expect(response.books).to.be.an(\"array\");\r\n});\r\n\r\npm.test(\"Books array is not empty\", function () {\r\n    const response = pm.response.json();\r\n    pm.expect(response.books.length).to.be.above(0);\r\n});"
            ]
          }
        }
